{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cheat-cards-server",
      "runtimeExecutable": "./.venv/bin/uvicorn",
      "runtimeArgs": [
        "main:asgi_app",
        "--reload",
        "--port",
        "8000"
      ],
      "cwd": "server",
      "port": 8000
    },
    {
      "name": "cheat-cards-client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--host"
      ],
      "cwd": "client",
      "port": 5173
    }
  ]
}
